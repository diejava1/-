' 重新出图：dot -Tpng 图4-8_核心逻辑实体关系.dot -o 图4-8_核心逻辑实体关系.png
@startdot
digraph G {
  graph [
    rankdir=TB,
    splines=ortho,
    nodesep=0.85,
    ranksep=0.85,
    pad=0.45,
    bgcolor=white,
    fontname="WenQuanYi Micro Hei"
  ];
  node [
    shape=box,
    style="filled,rounded",
    fontname="WenQuanYi Micro Hei",
    fontsize=14,
    color="#4B4F51",
    penwidth=1.2,
    margin="0.22,0.14",
    height=0.52
  ];
  edge [
    fontname="WenQuanYi Micro Hei",
    fontsize=12,
    color="#333333",
    penwidth=1.1,
    dir=none,
    arrowsize=0,
    labeldistance=2.4
  ];

  id [label="业务身份配置", fillcolor="#FFF3E0"];
  plugin [label="插件记录", fillcolor="#FFF3E0"];
  call [label="调用记录", fillcolor="#FFF3E0"];
  goods [label="商品关联", fillcolor="#E8F5E9"];
  cal [label="本地价格日历", fillcolor="#E8F5E9"];
  exec [label="本地执行单", fillcolor="#E8F5E9"];
  ext [label="供应商订单关联", fillcolor="#E3F2FD"];
  voucher [label="电子凭证", fillcolor="#E3F2FD"];
  refund [label="退款执行记录", fillcolor="#FFF3E0"];

  { rank=same; id; plugin; goods; cal }
  { rank=same; call; exec; ext }
  { rank=same; voucher; refund }

  id -> plugin [style=invis, weight=8];
  plugin -> goods [style=invis, weight=8];
  goods -> cal [style=invis, weight=8];
  call -> exec [style=invis, weight=8];
  exec -> ext [style=invis, weight=8];
  voucher -> refund [style=invis, weight=8];

  plugin -> call [style=invis, weight=8];
  goods -> exec [style=invis, weight=8];
  cal -> ext [style=invis, weight=8];
  exec -> voucher [style=invis, weight=8];
  ext -> refund [style=invis, weight=8];

  id -> plugin [taillabel="0..*", headlabel="1"];
  plugin -> call [taillabel="1", headlabel="0..*"];
  call -> exec [taillabel="0..*", headlabel="1"];
  goods -> cal [taillabel="1", headlabel="0..*"];
  goods -> exec [taillabel="1", headlabel="0..*"];
  exec -> ext [taillabel="1", headlabel="0..1"];
  exec -> voucher [taillabel="1", headlabel="0..*"];
  exec -> refund [taillabel="1", headlabel="0..*"];
  voucher -> refund [taillabel="0..*", headlabel="0..*"];
}
@enddot
