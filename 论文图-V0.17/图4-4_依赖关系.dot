digraph G {
  graph [
    splines=line,
    pad=0.3,
    bgcolor=white
  ];
  node [
    shape=box,
    style="filled,rounded",
    fontname="WenQuanYi Micro Hei",
    fontsize=16,
    color="#4B4F51",
    penwidth=1.2,
    margin="0.18,0.10"
  ];
  edge [
    color="#333333",
    penwidth=1.2,
    arrowsize=0.75,
    fontname="WenQuanYi Micro Hei",
    fontsize=14
  ];

  core [label="微内核", fillcolor="#E8F5E9", pos="70,250!"];
  store [label="执行单持久化", fillcolor="#E8F5E9", pos="340,250!"];
  sync [label="价格库存同步模块", fillcolor="#E8F5E9", pos="70,120!"];
  api [label="Plugin API", fillcolor="#F3F0F7", pos="360,120!"];
  runtime [label="插件运行时", fillcolor="#E8F5E9", pos="70,-10!"];
  pf4j [label="PF4J", fillcolor="#FFF3E0", pos="70,-130!"];
  impl [label="扩展实现", fillcolor="#E3F2FD", pos="620,-10!"];
  sdk [label="私有 SDK", fillcolor="#E3F2FD", pos="880,-10!"];

  core -> store;
  sync -> api;
  core -> api;
  runtime -> api;
  runtime -> pf4j;
  impl -> sdk;
  impl -> api;
  runtime -> impl [style=dashed, xlabel="运行时加载"];
}
