' 重新出图：dot -Tpng 图4-5_业务状态约束.dot -o 图4-5_业务状态约束.png
@startdot
digraph G {
  graph [
    rankdir=TB,
    splines=ortho,
    nodesep=0.55,
    ranksep=0.62,
    pad=0.4,
    bgcolor=white,
    fontname="WenQuanYi Micro Hei"
  ];
  node [
    shape=box,
    style="filled,rounded",
    fontname="WenQuanYi Micro Hei",
    fontsize=14,
    fillcolor=white,
    color="#4B4F51",
    penwidth=1.2,
    margin="0.18,0.10",
    height=0.48
  ];
  edge [
    fontname="WenQuanYi Micro Hei",
    fontsize=12,
    color="#333333",
    penwidth=1.1,
    arrowsize=0.7
  ];

  subgraph cluster_phase {
    label="执行阶段";
    labelloc=t;
    fontname="WenQuanYi Micro Hei";
    fontsize=15;
    style=filled;
    fillcolor="#E8F5E9";
    color="#4B4F51";
    margin=16;
    s0 [label="下单阶段待处理"];
    s1 [label="下单阶段已处理"];
    s5 [label="占用已撤销"];
    s2 [label="支付阶段待处理"];
    s3 [label="出票待确认"];
    s4 [label="出票已确认"];
    { rank=same; s1; s5 }
    { rank=same; s3; s4 }
    s0 -> s1 [label="阶段完成，B不表示外部锁库"];
    s1 -> s5 [label="支付前逆向"];
    s1 -> s2 [label="进入支付阶段"];
    s2 -> s3 [label="尚无最终出票事实"];
    s2 -> s4 [label="当次已确定出票"];
    s3 -> s4 [label="查询确认出票"];
  }

  subgraph cluster_ticket {
    label="凭证约束";
    labelloc=t;
    fontname="WenQuanYi Micro Hei";
    fontsize=15;
    style=filled;
    fillcolor="#E3F2FD";
    color="#4B4F51";
    margin=16;
    v0 [label="凭证未保存"];
    v1 [label="凭证已保存"];
    v2 [label="使用事实已更新"];
    v0 -> v1 [label="出票事实已确认"];
    v1 -> v2 [label="核销通知"];
  }

  subgraph cluster_refund {
    label="退款约束";
    labelloc=t;
    fontname="WenQuanYi Micro Hei";
    fontsize=15;
    style=filled;
    fillcolor="#FFF3E0";
    color="#4B4F51";
    margin=16;
    r0 [label="退款待执行"];
    r1 [label="退款已受理"];
    r2 [label="退款已完成"];
    r0 -> r1 [label="外部受理"];
    r1 -> r2 [label="确认完成"];
  }
}
@enddot
