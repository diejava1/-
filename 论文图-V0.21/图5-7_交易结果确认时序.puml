' 图5-5 交易结果确认。定时任务只触发查询，不再次发起出票。
@startuml
skinparam shadowing false
skinparam dpi 140
skinparam defaultFontName "WenQuanYi Micro Hei"
skinparam defaultFontSize 14
skinparam roundcorner 6
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 16
skinparam BoxPadding 14

skinparam sequence {
  ArrowColor #333333
  ArrowFontSize 14
  ActorBorderColor #4B4F51
  ActorBackgroundColor #FFFFFF
  ActorFontColor #222222
  ActorFontSize 14
  ParticipantBorderColor #4B4F51
  ParticipantBackgroundColor #E2E2F0
  ParticipantFontColor #222222
  ParticipantFontSize 14
  LifeLineBorderColor #8E958E
  LifeLineBackgroundColor #FFFFFF
  BoxBorderColor #4B4F51
  BoxFontColor #222222
  BoxFontSize 15
  BoxFontStyle bold
  GroupBorderColor #333333
  GroupFontColor #222222
  GroupHeaderFontColor #222222
  GroupBodyBackgroundColor transparent
  GroupHeaderBackgroundColor #FFFFFF
}

actor "本系统\n定时任务" as Job

box "核心交易层" #E8F5E9
participant "交易执行引擎" as Core
end box

box "插件运行层" #FFF3E0
participant "插件运行时" as Runtime
end box

box "供应商插件层" #E3F2FD
participant "查询扩展" as Plugin
end box

actor "供应商系统" as Supplier

autonumber

Job -> Core : 提交待确认的执行
activate Core
Core -> Core : 读取原请求与已有外部关联
Core -> Runtime : 请求查询扩展
activate Runtime
Runtime -> Plugin : 调用查询
activate Plugin
Plugin -> Supplier : 按已保存关联查询
activate Supplier
Supplier --> Plugin : 返回查询响应
deactivate Supplier
Plugin --> Runtime : 返回标准结果
deactivate Plugin
Runtime --> Core : 返回标准结果
deactivate Runtime

alt 尚未出票
  Core -> Core : 保留待确认进度
else 取得出票结果
  Core -> Core : 保存凭证并准备回传
else 查询异常
  Core -> Core : 记录本次失败，不清除已有事实
end
deactivate Core

@enduml
