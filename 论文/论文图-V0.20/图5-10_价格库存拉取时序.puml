' 图5-8 价格库存拉取与更新。不经过交易命令状态更新入口。
@startuml
skinparam shadowing false
skinparam dpi 140
skinparam defaultFontName "WenQuanYi Micro Hei"
skinparam defaultFontSize 14
skinparam roundcorner 6
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 12
skinparam BoxPadding 12

skinparam sequence {
  ArrowColor #333333
  ArrowFontSize 14
  ActorBorderColor #4B4F51
  ActorBackgroundColor #FFFFFF
  ActorFontColor #222222
  ActorFontSize 14
  ParticipantBorderColor #4B4F51
  ParticipantBackgroundColor #E2E2F0
  ParticipantFontColor #222222
  ParticipantFontSize 14
  LifeLineBorderColor #8E958E
  LifeLineBackgroundColor #FFFFFF
  BoxBorderColor #4B4F51
  BoxFontColor #222222
  BoxFontSize 15
  BoxFontStyle bold
  GroupBorderColor #333333
  GroupFontColor #222222
  GroupHeaderFontColor #222222
  GroupBodyBackgroundColor transparent
  GroupHeaderBackgroundColor #FFFFFF
}

actor "同步任务" as Job

box "核心交易层" #E8F5E9
participant "价格库存\n同步模块" as Sync
participant "商品关联" as Goods
participant "本地价格日历" as Cal
end box

box "插件运行层" #FFF3E0
participant "插件运行时" as Runtime
end box

box "供应商插件层" #E3F2FD
participant "价格库存扩展" as Plugin
end box

actor "外部场次接口" as Remote

autonumber

Job -> Sync : 按范围触发同步
activate Sync
Sync -> Goods : 读取有效商品关联
activate Goods
Goods --> Sync : 返回关联
deactivate Goods
Sync -> Runtime : 请求价格库存扩展
activate Runtime
Runtime -> Plugin : 调用拉取
activate Plugin
Plugin -> Remote : 拉取场次与价格库存
activate Remote
Remote --> Plugin : 返回外部数据
deactivate Remote
Plugin -> Plugin : 转换为标准日历
Plugin --> Runtime : 返回标准结果
deactivate Plugin
Runtime --> Sync : 返回标准结果
deactivate Runtime

alt 取得有效结果
  Sync -> Sync : 校验并与已有记录比较
  Sync -> Cal : 只写入有变化的记录
  activate Cal
  Cal --> Sync : 完成
  deactivate Cal
else 未取得有效响应
  Sync -> Sync : 保留最近一次可用记录
end
deactivate Sync

@enduml
